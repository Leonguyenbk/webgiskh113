# Bắt buộc để kết nối Supabase (Settings > API trong project Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Danh sách origin frontend được phép gọi API, cách nhau bởi dấu phẩy.
# "*" (mặc định) nghĩa là cho phép mọi origin — chỉ dùng khi phát triển.
FRONTEND_URL=*

# Mã xác thực cho các endpoint quản trị (nhập GML/đồng bộ, quản lý nguồn
# GCN, cập nhật MPLIS) — header X-Import-Token. Để trống thì các endpoint
# đó không yêu cầu mã xác thực.
IMPORT_TOKEN=

# Nội dung file service_account.json (Google Cloud) dán nguyên văn thành 1
# dòng — dùng để đọc Google Sheet cho tính năng đồng bộ dữ liệu GCN.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Upload hồ sơ quét PDF của biểu Nhóm 4 lên Google Drive dùng OAuth ủy
# quyền bằng tài khoản Gmail cá nhân (KHÔNG dùng Service Account — Service
# Account cá nhân không có dung lượng lưu trữ riêng trên Drive). Chạy
# backend/scripts/get_drive_oauth_refresh_token.py một lần cục bộ để lấy cả
# 3 giá trị dưới đây (xem hướng dẫn đầy đủ trong docstring của script đó).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID folder gốc trên Google Drive để lưu hồ sơ quét PDF của biểu Nhóm 4 —
# tạo bình thường trên Drive của chính tài khoản đã ủy quyền OAuth ở trên,
# copy ID từ URL folder rồi dán vào đây (không cần chạy script tạo riêng).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Tùy chọn — mặc định 5000, false.
# PORT=5000
# FLASK_DEBUG=false
