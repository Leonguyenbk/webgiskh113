# Bắt buộc để kết nối Supabase (Settings > API trong project Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Danh sách origin frontend được phép gọi API, cách nhau bởi dấu phẩy.
# "*" (mặc định) nghĩa là cho phép mọi origin — chỉ dùng khi phát triển.
FRONTEND_URL=*

# Mã xác thực cho các endpoint quản trị (nhập GML/đồng bộ, quản lý nguồn
# GCN, cập nhật MPLIS) — header X-Import-Token. Để trống thì các endpoint
# đó không yêu cầu mã xác thực.
IMPORT_TOKEN=

# Nội dung file service_account.json (Google Cloud) dán nguyên văn thành 1
# dòng — dùng để đọc Google Sheet cho tính năng đồng bộ dữ liệu GCN.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Tùy chọn — mặc định 5000, false.
# PORT=5000
# FLASK_DEBUG=false
